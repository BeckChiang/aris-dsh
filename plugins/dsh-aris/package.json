{
  "name": "@local/dsh-aris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ARIS 流水线面板：在 Web UI 侧栏同时监控多条 ARIS 流水线的阶段、闸门、审查与下一步，并提供收件、闸门/登记产物等白名单动作。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
